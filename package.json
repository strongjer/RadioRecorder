{
  "name": "radiorecorder",
  "productName": "RadioRecorder",
  "version": "1.0.2",
  "private": true,
  "description": "A voice-activated recording console for macOS, Windows, and Linux.",
  "author": "RadioRecorder contributors",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:app": "node scripts/smoke.cjs",
    "pack": "electron-builder --dir",
    "dist:mac": "node scripts/prepare-macos-encoder.cjs && electron-builder --mac dmg zip --publish never",
    "dist:win": "node scripts/build-windows.cjs",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "postinstall": "node node_modules/electron/install.js",
    "test:captions": "node scripts/live-caption-check.cjs",
    "icons": "node scripts/icons.cjs"
  },
  "build": {
    "appId": "app.radiorecorder.desktop",
    "asar": true,
    "toolsets": {
      "nsis": "1.2.1"
    },
    "files": [
      "app/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/onnxruntime-web/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "resources/icon.icns",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "RadioRecorder uses your selected audio input to monitor and record transmissions."
      },
      "files": [
        "app/**/*",
        "package.json",
        "THIRD_PARTY_NOTICES.md",
        "!node_modules/onnxruntime-web/**/*",
        "!node_modules/onnxruntime-node/bin/napi-v6/{linux,win32}/**/*"
      ],
      "binaries": [
        "Contents/Resources/app.asar.unpacked/node_modules/ffmpeg-static/ffmpeg"
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": "portable",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-${version}-Windows-${arch}-Portable.${ext}",
      "extraResources": [
        {
          "from": "bundled-models",
          "to": "bundled-models",
          "filter": [
            "Xenova/whisper-base/**/*"
          ]
        }
      ],
      "extraFiles": [
        {
          "from": "windows-runtime",
          "to": "."
        }
      ],
      "files": [
        "app/**/*",
        "package.json",
        "THIRD_PARTY_NOTICES.md",
        "!node_modules/onnxruntime-web/**/*",
        "!node_modules/onnxruntime-node/bin/napi-v6/{linux,darwin}/**/*",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**/*"
      ]
    },
    "portable": {
      "requestExecutionLevel": "user",
      "unpackDirName": false
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "RadioRecorder contributors",
      "files": [
        "app/**/*",
        "package.json",
        "THIRD_PARTY_NOTICES.md",
        "!node_modules/onnxruntime-web/**/*",
        "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,win32}/**/*"
      ]
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg*",
      "node_modules/onnxruntime-node/bin/**/*"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@ozymandiasthegreat/vad": "^2.0.7",
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-node": "1.30.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
